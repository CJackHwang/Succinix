{
  "name": "succinix",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "POC: Lifo (Unix-in-TypeScript) running inside WebContainer, sharing the container filesystem via node:fs mount.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CJackHwang/Succinix.git"
  },
  "homepage": "https://github.com/CJackHwang/Succinix",
  "bugs": {
    "url": "https://github.com/CJackHwang/Succinix/issues"
  },
  "scripts": {
    "dev": "node scripts/start-dev.mjs",
    "build:host": "node scripts/build-host.mjs",
    "build": "npm run build:host && vite build",
    "build:engine-package": "npm run build:host && node scripts/build-engine-package.mjs",
    "check:plugin-boundaries": "node scripts/check-plugin-boundaries.mjs",
    "check:engine-package": "npm run build:engine-package && cd packages/engine && npm pack --dry-run",
    "check:dsh-shapes": "node scripts/check-dsh-shapes.mjs --types",
    "check:dsh-keys": "node scripts/check-dsh-keys.mjs src tests examples",
    "verify:engine-package": "npm run check:engine-package",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/run-e2e.mjs",
    "audit:files": "node scripts/audit-file-size.mjs --fail",
    "check:static": "node scripts/check-static.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run audit:files && npm run check:static && npm run check:engine-package && npm run check:docs && npm run check:plugin-boundaries && npm run check:dsh-shapes && npm run check:dsh-keys",
    "check:e2e": "npm run check && npm run test:e2e",
    "setup:hooks": "node scripts/setup-hooks.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lifo-sh/core": "^0.10.8",
    "@webcontainer/api": "^1.6.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@cordisjs/plugin-database-memory": "^4.1.1",
    "@cordisjs/plugin-hmr": "^1.0.15",
    "@cordisjs/plugin-loader": "^1.0.0-rc.5",
    "@cordisjs/plugin-logger-console": "^1.0.0",
    "@cordisjs/plugin-timer": "^1.1.2",
    "@deepseek-ai/cordis": "^4.0.1",
    "@eslint/js": "^10.0.1",
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "cordis": "^4.0.0-rc.8",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "globals": "^16.5.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
