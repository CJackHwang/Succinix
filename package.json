  "dependencies": {
    "@lifo-sh/core": "^0.10.8",
    "@webcontainer/api": "^1.6.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "typescript": "~7.0.2",
    "vite": "^8.2.0"
  }
}
